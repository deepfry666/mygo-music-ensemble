{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/*/src/**/*.ts", "plugins/*/src/**/*.ts"]
}
